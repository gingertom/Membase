#!/usr/bin/env python3
"""
Membase - Git-native project memory system for Claude Code.

A simple, git-friendly project memory system that stores decisions,
implementation notes, and documentation with multi-dimensional tagging.
"""

import argparse
import difflib
import json
import os
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


# Constants
MEMBASE_DIR = ".membase"
SCHEMA_FILE = "schema.json"
MEMORIES_FILE = "memories.jsonl"

DEFAULT_SCHEMA = {
    "dimensions": {
        "topic": "Project-specific subject areas",
        "phase": "Workflow stage or document type"
    },
    "values": {
        "topic": [],
        "phase": [
            "requirements",
            "decision",
            "planning",
            "backend-implementation",
            "frontend-implementation",
            "testing",
            "documentation",
            "troubleshooting",
            "deployment"
        ]
    }
}


# Helper Functions

def get_membase_paths() -> Tuple[Path, Path, Path]:
    """Get paths to membase directory and files."""
    base = Path.cwd() / MEMBASE_DIR
    schema = base / SCHEMA_FILE
    memories = base / MEMORIES_FILE
    return base, schema, memories


def check_membase_exists() -> None:
    """Check if membase is initialized, exit if not."""
    base, _, _ = get_membase_paths()
    if not base.exists():
        error("Not a membase project. Run 'mb init' first.")
        sys.exit(1)


def load_schema() -> Dict[str, Any]:
    """Load schema from file."""
    _, schema_path, _ = get_membase_paths()
    try:
        with open(schema_path, 'r', encoding='utf-8') as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError) as e:
        error(f"Failed to load schema: {e}")
        sys.exit(1)


def save_schema(schema: Dict[str, Any]) -> None:
    """Save schema to file with sorted values."""
    _, schema_path, _ = get_membase_paths()

    # Sort dimension values alphabetically
    for dim in schema["values"]:
        schema["values"][dim] = sorted(schema["values"][dim])

    # Write atomically
    temp_path = schema_path.with_suffix('.tmp')
    try:
        with open(temp_path, 'w', encoding='utf-8') as f:
            json.dump(schema, f, indent=2, ensure_ascii=False)
            f.write('\n')
        temp_path.replace(schema_path)
    except Exception as e:
        if temp_path.exists():
            temp_path.unlink()
        error(f"Failed to save schema: {e}")
        sys.exit(1)


def load_memories() -> List[Dict[str, Any]]:
    """Load all memories from file."""
    _, _, memories_path = get_membase_paths()

    if not memories_path.exists():
        return []

    memories = []
    try:
        with open(memories_path, 'r', encoding='utf-8') as f:
            for line_num, line in enumerate(f, 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    memories.append(json.loads(line))
                except json.JSONDecodeError as e:
                    error(f"Invalid JSON on line {line_num}: {e}")
                    sys.exit(1)
    except Exception as e:
        error(f"Failed to load memories: {e}")
        sys.exit(1)

    return memories


def save_memories(memories: List[Dict[str, Any]]) -> None:
    """Save memories to file, sorted by UUID."""
    _, _, memories_path = get_membase_paths()

    # Sort by UUID
    memories.sort(key=lambda m: m["id"])

    # Write atomically
    temp_path = memories_path.with_suffix('.tmp')
    try:
        with open(temp_path, 'w', encoding='utf-8') as f:
            for memory in memories:
                json.dump(memory, f, separators=(',', ':'), ensure_ascii=False)
                f.write('\n')
        temp_path.replace(memories_path)
    except Exception as e:
        if temp_path.exists():
            temp_path.unlink()
        error(f"Failed to save memories: {e}")
        sys.exit(1)


def validate_tags(tags: Dict[str, str], schema: Dict[str, Any]) -> None:
    """Validate tags against schema, exit on error."""
    if not tags:
        error("At least one tag is required")
        sys.exit(1)

    dimensions = schema["dimensions"]
    values = schema["values"]

    for dim, val in tags.items():
        # Check dimension exists
        if dim not in dimensions:
            suggestion = difflib.get_close_matches(dim, dimensions.keys(), n=1, cutoff=0.6)
            if suggestion:
                error(f"Unknown dimension '{dim}'. Did you mean: {suggestion[0]}?")
            else:
                error(f"Unknown dimension '{dim}'. Available: {', '.join(sorted(dimensions.keys()))}")
            sys.exit(1)

        # Check value exists
        if val not in values[dim]:
            suggestion = difflib.get_close_matches(val, values[dim], n=1, cutoff=0.6)
            if suggestion:
                error(f"Unknown value '{val}' for dimension '{dim}'. Did you mean: {suggestion[0]}?")
            else:
                available = ', '.join(sorted(values[dim])) if values[dim] else "(none defined)"
                error(f"Unknown value '{val}' for dimension '{dim}'. Available: {available}")
            sys.exit(1)


def validate_summary(summary: str) -> None:
    """Validate summary length."""
    if len(summary) > 100:
        error(f"Summary too long ({len(summary)} chars, max 100)")
        sys.exit(1)


def find_memory_by_id_prefix(memories: List[Dict[str, Any]], prefix: str) -> Dict[str, Any]:
    """Find memory by ID prefix, handle ambiguity."""
    matches = [m for m in memories if m["id"].startswith(prefix)]

    if not matches:
        error(f"Memory '{prefix}' not found")
        sys.exit(1)

    if len(matches) > 1:
        ids = ', '.join([m["id"][:12] + '...' for m in matches])
        error(f"Ambiguous ID '{prefix}', matches: {ids}")
        sys.exit(1)

    return matches[0]


def now_iso() -> str:
    """Get current timestamp in ISO 8601 format with timezone."""
    return datetime.now(timezone.utc).isoformat()


def success(msg: str) -> None:
    """Print success message."""
    print(f"✓ {msg}")


def error(msg: str) -> None:
    """Print error message to stderr."""
    print(f"✗ {msg}", file=sys.stderr)


def parse_tag_args(args: List[str]) -> Dict[str, str]:
    """Parse dimension=value arguments."""
    tags = {}
    for arg in args:
        if '=' not in arg:
            error(f"Invalid tag format '{arg}'. Use: dimension=value")
            sys.exit(1)
        dim, val = arg.split('=', 1)
        tags[dim] = val
    return tags


# Command Implementations

def cmd_init(args: argparse.Namespace) -> None:
    """Initialize membase directory."""
    base, schema_path, memories_path = get_membase_paths()

    if base.exists():
        error(f"Membase already initialized at {base}")
        sys.exit(1)

    # Create directory
    base.mkdir(parents=True, exist_ok=True)

    # Create schema
    with open(schema_path, 'w', encoding='utf-8') as f:
        json.dump(DEFAULT_SCHEMA, f, indent=2, ensure_ascii=False)
        f.write('\n')

    # Create empty memories file
    memories_path.touch()

    success(f"Initialized membase at {base}")


def cmd_add(args: argparse.Namespace) -> None:
    """Add a new memory."""
    check_membase_exists()

    # Validate inputs
    if not args.summary:
        error("Summary is required (-s)")
        sys.exit(1)

    if not args.content:
        error("Content is required (-c)")
        sys.exit(1)

    validate_summary(args.summary)

    # Parse and validate tags
    tags = parse_tag_args(args.tags)
    schema = load_schema()
    validate_tags(tags, schema)

    # Create memory
    memory = {
        "id": str(uuid.uuid4()),
        "summary": args.summary,
        "content": args.content,
        "tags": tags,
        "created_at": now_iso()
    }

    # Save
    memories = load_memories()
    memories.append(memory)
    save_memories(memories)

    success(f"Added memory {memory['id'][:8]}")


def cmd_query(args: argparse.Namespace) -> None:
    """Query memories."""
    check_membase_exists()

    memories = load_memories()

    # Filter by ID if specified
    if args.id:
        memory = find_memory_by_id_prefix(memories, args.id)
        print_memory_full(memory)
        return

    # Parse tag filters
    tag_filters = {}
    if args.filters:
        for filt in args.filters:
            if '=' in filt:
                dim, val = filt.split('=', 1)
                tag_filters[dim] = val
            elif filt.startswith('--'):
                # Skip flags
                continue
            else:
                error(f"Invalid filter '{filt}'. Use: --dimension value or dimension=value")
                sys.exit(1)

    # Handle --dimension value format
    schema = load_schema()
    for dim in schema["dimensions"]:
        flag_name = f"--{dim}"
        if hasattr(args, dim.replace('-', '_')) and getattr(args, dim.replace('-', '_')):
            tag_filters[dim] = getattr(args, dim.replace('-', '_'))

    # Apply filters
    results = memories

    # Tag filters (AND logic)
    for dim, val in tag_filters.items():
        results = [m for m in results if m.get("tags", {}).get(dim) == val]

    # Search filter
    if args.search:
        search_lower = args.search.lower()
        results = [
            m for m in results
            if search_lower in m["summary"].lower() or search_lower in m["content"].lower()
        ]

    # Apply limit
    limit = args.limit if args.limit else 50
    total_results = len(results)
    results = results[:limit]

    # Output format
    if args.json:
        print(json.dumps(results, indent=2))
        return

    if not results:
        print("No memories found")
        return

    # Adaptive detail level
    show_full = args.full or (not args.brief and len(results) <= 5)

    if show_full:
        for i, memory in enumerate(results):
            if i > 0:
                print()
            print_memory_full(memory)
    else:
        for memory in enumerate(results):
            print_memory_brief(memory[1])

        print()
        suffix = f" (showing {len(results)} of {total_results})" if len(results) < total_results else ""
        print(f"({len(results)} memories{suffix}. Use --full for details or --id <uuid> for one.)")


def print_memory_brief(memory: Dict[str, Any]) -> None:
    """Print memory in brief format."""
    id_short = memory["id"][:8]
    tags_str = ' '.join([f"{k}={v}" for k, v in memory.get("tags", {}).items()])
    print(f"{id_short} [{tags_str}]")
    print(f"    {memory['summary']}")


def print_memory_full(memory: Dict[str, Any]) -> None:
    """Print memory in full format."""
    id_short = memory["id"][:8]
    tags_str = ' '.join([f"{k}={v}" for k, v in memory.get("tags", {}).items()])

    print(f"─── {id_short} ───")
    print(f"[{tags_str}]")
    print(f"Summary: {memory['summary']}")
    print()
    print(memory["content"])
    print()
    print(f"Created: {memory['created_at']}")
    if "updated_at" in memory:
        print(f"Updated: {memory['updated_at']}")


def cmd_dims(args: argparse.Namespace) -> None:
    """Manage dimensions."""
    check_membase_exists()
    schema = load_schema()

    # Add value to existing dimension
    if args.dims_action == 'add':
        dim = args.dimension
        val = args.value

        if dim not in schema["dimensions"]:
            error(f"Dimension '{dim}' does not exist")
            sys.exit(1)

        if val in schema["values"][dim]:
            error(f"Value '{val}' already exists in dimension '{dim}'")
            sys.exit(1)

        schema["values"][dim].append(val)
        save_schema(schema)
        success(f"Added value '{val}' to dimension '{dim}'")
        return

    # Add new dimension
    if args.dims_action == 'add-dim':
        name = args.name
        description = args.description or f"Custom dimension: {name}"

        if name in schema["dimensions"]:
            error(f"Dimension '{name}' already exists")
            sys.exit(1)

        schema["dimensions"][name] = description
        schema["values"][name] = []
        save_schema(schema)
        success(f"Added dimension '{name}'")
        return

    # List dimensions (no action specified)
    print("Dimensions:")
    print()
    for dim, desc in sorted(schema["dimensions"].items()):
        print(f"{dim}:")
        print(f"  {desc}")
        values = schema["values"].get(dim, [])
        if values:
            for val in values:
                print(f"  - {val}")
        else:
            print("  (no values defined)")
        print()


def cmd_edit(args: argparse.Namespace) -> None:
    """Edit an existing memory."""
    check_membase_exists()

    memories = load_memories()
    memory = find_memory_by_id_prefix(memories, args.id)

    # Update fields
    if args.summary:
        validate_summary(args.summary)
        memory["summary"] = args.summary

    if args.content:
        memory["content"] = args.content

    # Update tags
    if args.tags:
        new_tags = parse_tag_args(args.tags)
        schema = load_schema()

        # Merge with existing tags
        memory["tags"].update(new_tags)
        validate_tags(memory["tags"], schema)

    # Set updated_at
    memory["updated_at"] = now_iso()

    # Save
    save_memories(memories)
    success(f"Updated memory {memory['id'][:8]}")


def cmd_delete(args: argparse.Namespace) -> None:
    """Delete a memory."""
    check_membase_exists()

    memories = load_memories()
    memory = find_memory_by_id_prefix(memories, args.id)

    # Confirm deletion
    if not args.yes:
        print_memory_brief(memory)
        print()
        response = input("Delete this memory? [y/N] ").strip().lower()
        if response not in ('y', 'yes'):
            print("Cancelled")
            return

    # Remove and save
    memories = [m for m in memories if m["id"] != memory["id"]]
    save_memories(memories)
    success(f"Deleted memory {memory['id'][:8]}")


def cmd_stats(args: argparse.Namespace) -> None:
    """Show statistics."""
    check_membase_exists()

    memories = load_memories()
    schema = load_schema()

    print(f"Total memories: {len(memories)}")
    print()

    # Count by dimension
    for dim in sorted(schema["dimensions"].keys()):
        print(f"{dim}:")
        counts = {}
        for memory in memories:
            val = memory.get("tags", {}).get(dim)
            if val:
                counts[val] = counts.get(val, 0) + 1

        if counts:
            for val, count in sorted(counts.items()):
                print(f"  {val}: {count}")
        else:
            print("  (no memories)")
        print()


# CLI Setup

def main():
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description="Membase - Git-native project memory system",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )

    subparsers = parser.add_subparsers(dest='command', help='Commands')

    # init
    subparsers.add_parser('init', help='Initialize membase directory')

    # add
    add_parser = subparsers.add_parser('add', help='Add a memory')
    add_parser.add_argument('-s', '--summary', required=True, help='Summary (max 100 chars)')
    add_parser.add_argument('-c', '--content', required=True, help='Full content')
    add_parser.add_argument('tags', nargs='+', help='Tags as dimension=value')

    # query
    query_parser = subparsers.add_parser('query', help='Query memories')
    query_parser.add_argument('filters', nargs='*', help='Filters as dimension=value')
    query_parser.add_argument('--id', help='Query by ID or prefix')
    query_parser.add_argument('--search', help='Full-text search')
    query_parser.add_argument('--all', action='store_true', help='List all memories')
    query_parser.add_argument('--json', action='store_true', help='Output as JSON')
    query_parser.add_argument('--full', action='store_true', help='Force detailed view')
    query_parser.add_argument('--brief', action='store_true', help='Force summary view')
    query_parser.add_argument('--limit', type=int, help='Limit results (default: 50)')

    # Add dynamic dimension filters
    query_parser.add_argument('--topic', help='Filter by topic')
    query_parser.add_argument('--phase', help='Filter by phase')

    # dims
    dims_parser = subparsers.add_parser('dims', help='Manage dimensions')
    dims_subparsers = dims_parser.add_subparsers(dest='dims_action', help='Dimension actions')

    # dims add <dimension> <value>
    dims_add_parser = dims_subparsers.add_parser('add', help='Add value to dimension')
    dims_add_parser.add_argument('dimension', help='Dimension name')
    dims_add_parser.add_argument('value', help='Value to add')

    # dims add-dim <name> [description]
    dims_add_dim_parser = dims_subparsers.add_parser('add-dim', help='Add new dimension')
    dims_add_dim_parser.add_argument('name', help='Dimension name')
    dims_add_dim_parser.add_argument('description', nargs='?', help='Dimension description')

    # edit
    edit_parser = subparsers.add_parser('edit', help='Edit a memory')
    edit_parser.add_argument('id', help='Memory ID or prefix')
    edit_parser.add_argument('-s', '--summary', help='New summary')
    edit_parser.add_argument('-c', '--content', help='New content')
    edit_parser.add_argument('tags', nargs='*', help='Tags to update as dimension=value')

    # delete
    delete_parser = subparsers.add_parser('delete', help='Delete a memory')
    delete_parser.add_argument('id', help='Memory ID or prefix')
    delete_parser.add_argument('-y', '--yes', action='store_true', help='Skip confirmation')

    # stats
    subparsers.add_parser('stats', help='Show statistics')

    # Parse and dispatch
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    # Dispatch
    commands = {
        'init': cmd_init,
        'add': cmd_add,
        'query': cmd_query,
        'dims': cmd_dims,
        'edit': cmd_edit,
        'delete': cmd_delete,
        'stats': cmd_stats
    }

    commands[args.command](args)


if __name__ == '__main__':
    main()
